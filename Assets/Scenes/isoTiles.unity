--- !u!114 &1755628620
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1755628619}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 21b8d2e01c88a43ebb40163b26a7b965, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: Classmate
        icon: {fileID: 21300000, guid: f38c96be720b34148990833d95d60e31, type: 3}
      line: " I\u2019-- n-ver se-n you b-fore. Are y-u n-w?"
    - character:
        name: Shelldon
        icon: {fileID: 21300000, guid: df503ea0d1a24443e88c736620b50830, type: 3}
      line: Yes, I new.
    - character:
        name: Micah
        icon: {fileID: 21300000, guid: f38c96be720b34148990833d95d60e31, type: 3}
      line: "Oh we-l, I\u2019m Micah. Wh-t\u2019s y-urs?"
    - character:
        name: Shelldon
        icon: {fileID: 21300000, guid: df503ea0d1a24443e88c736620b50830, type: 3}
      line: Uh oh, Shelldon!
    - character:
        name: Micah
        icon: {fileID: 21300000, guid: f38c96be720b34148990833d95d60e31, type: 3}
      line: H-w Uniq-e. Whe-re did y-u mo-e fr-m?
    - character:
        name: Shelldon
        icon: {fileID: 21300000, guid: df503ea0d1a24443e88c736620b50830, type: 3}
      line: (What uniq-e?) Oh yes. The ocean
    - character:
        name: Teacher
        icon: {fileID: 21300000, guid: 1ece3be08d6264ff4a735b1eed781773, type: 3}
      line: "Clas-, let\u2019s beg-n"
    - character:
        name: Micah
        icon: {fileID: 21300000, guid: f38c96be720b34148990833d95d60e31, type: 3}
      line: Hmm, a-right Shelldon fr-m the ocean, we sh-uld ta-k mo-e at lunc-.
    - character:
        name: Shelldon
        icon: {fileID: 21300000, guid: df503ea0d1a24443e88c736620b50830, type: 3}
      line: Lunch? Food, right?
    - character:
        name: Micah
        icon: {fileID: 21300000, guid: f38c96be720b34148990833d95d60e31, type: 3}
      line: Ye-h obvi-us-y. Wh-t else is lun-h for?
    - character:
        name: Shelldon
        icon: {fileID: 21300000, guid: df503ea0d1a24443e88c736620b50830, type: 3}
      line: Ok, talk at food time.
  collidedIcon: 0
